#!/usr/bin/env python3
"""Downloads the bundled scene fonts (SIL Open Font License 1.1).

Static latin TTFs come from Fontsource (jsDelivr); licence texts come from the
google/fonts repository. Everything lands in scenes/_shared/fonts with a
SOURCES file recording where each file came from.
"""
import urllib.request
from pathlib import Path

OUT = Path(__file__).resolve().parent.parent / "scenes/_shared/fonts"
FONTS = {
    # fontsource id: (google/fonts licence path or ofl dir, file prefix, [weight-style ...])
    "outfit": ("outfit", "Outfit", ["200-normal", "400-normal", "800-normal"]),
    "space-mono": ("spacemono", "SpaceMono", ["400-normal"]),
    "fredoka": ("fredoka", "Fredoka", ["500-normal", "700-normal"]),
    "jetbrains-mono": ("jetbrainsmono", "JetBrainsMono", ["300-normal", "500-normal"]),
    "league-spartan": ("leaguespartan", "LeagueSpartan", ["400-normal", "800-normal"]),
    "shippori-mincho": ("shipporimincho", "ShipporiMincho", ["500-normal", "800-normal"]),
    "anton": ("anton", "Anton", ["400-normal"]),
}
NAMES = {"100": "Thin", "200": "ExtraLight", "300": "Light", "400": "Regular", "500": "Medium", "600": "SemiBold", "700": "Bold", "800": "ExtraBold"}


def fetch(url):
    with urllib.request.urlopen(url, timeout=30) as response:
        return response.read()


OUT.mkdir(parents=True, exist_ok=True)
sources = []
for font_id, (ofl, prefix, styles) in FONTS.items():
    for style in styles:
        weight, slant = style.split("-")
        name = f"{prefix}-{NAMES[weight]}{'Italic' if slant == 'italic' else ''}.ttf"
        url = f"https://cdn.jsdelivr.net/fontsource/fonts/{font_id}@latest/latin-{style}.ttf"
        data = fetch(url)
        if data[:4] not in (b"\x00\x01\x00\x00", b"true", b"OTTO"):
            raise SystemExit(f"{url} is not a font")
        (OUT / name).write_bytes(data)
        sources.append(f"{name}\t{url}")
    path = ofl if "/" in ofl else f"ofl/{ofl}/OFL.txt"
    licence_name = f"{prefix}-{'LICENSE' if path.startswith('apache') else 'OFL'}.txt"
    (OUT / licence_name).write_bytes(fetch(f"https://raw.githubusercontent.com/google/fonts/main/{path}"))
    sources.append(f"{licence_name}\thttps://github.com/google/fonts/blob/main/{path}")
(OUT / "SOURCES.tsv").write_text("\n".join(sources) + "\n")
print(f"{len(sources)} files in {OUT}")
